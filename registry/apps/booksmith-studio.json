{
  "id": "booksmith-studio",
  "name": "BookSmith Studio",
  "description": "Author-first AIFT publishing and studio workspace.",
  "status": "planned",
  "runtime": "local-web",
  "command": ["npm", "run", "studio"],
  "working_dir": "booksmith-ai",
  "metadata": {
    "schema": "https://aifreedomtrust.org/schemas/aift.os.app-ref.schema.json",
    "repo": "AIFreedomTrustFederation/booksmith-ai",
    "category": "publishing",
    "url": "http://localhost:3000/studio",
    "operator_runtime": {
      "primary": "OpenHands",
      "model_runtime": "Ollama",
      "fallback_cli_editor_agent": "Aider",
      "editors": ["VS Code", "VSCodium", "Neovim"],
      "host": "local Linux machine",
      "not_host": "phone Termux"
    },
    "launch_policy": "planned_until_local_verification",
    "verification_required": true,
    "notes": "Launch remains planned until AIFT-OS can verify the local Linux workspace and command successfully."
  }
}
