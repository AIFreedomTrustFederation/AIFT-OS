{
  "id": "mobox-uxi",
  "name": "Federation Console",
  "description": "Conversation-first AIFT operator console with governed adapters and Living Federation APIs.",
  "status": "ready",
  "runtime": "go-http",
  "command": [
    "go",
    "run",
    "./cmd/aiftd"
  ],
  "working_dir": ".",
  "metadata": {
    "mode": "governed-read-only-execution",
    "bind": "127.0.0.1:8787",
    "model_endpoint": "http://127.0.0.1:8080/v1",
    "approval_contract": "approval authorizes only the exact recorded action; mutating adapters remain disabled",
    "registered_adapters": [
      "repository.inspect",
      "forge.mission.inspect",
      "source.inspect"
    ],
    "artifact_contract": "read-only adapter results are private JSON artifacts with SHA-256 digests",
    "federation_geometry": {
      "schema": "aift.federation.geometry.v1",
      "endpoint": "/v1/federation/geometry",
      "recurrence": "z(n+1)=z(n)^2+c",
      "dimensions": 3,
      "identity": "deterministic repository seed",
      "growth": "observed evidence only"
    },
    "naming": {
      "product": "Federation Console",
      "legacy_id": "mobox-uxi",
      "compatibility_runtime": "AIFreedomTrustFederation/mobox",
      "boundary": "The compatibility runtime executes Windows applications; this console owns neither Wine nor Box64."
    },
    "world_protocol": {
      "schema": "aift.world.v1",
      "endpoint": "/v1/federation/world-snapshot",
      "coordinates": "signed 64-bit decimal logical nanounits",
      "mutation_mode": "proposal-only"
    }
  }
}
